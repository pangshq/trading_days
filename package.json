{
  "name": "@pangshq/trading_days",
  "version": "1.0.2",
  "description": "Check if a date is an A-Share trading day",
  "license": "MIT",
  "author": "pangshq",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/pangshq/trading_days"
  },
  "keywords": [
    "a-share",
    "trading-day",
    "stock-market",
    "china",
    "holiday"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.esm.json && mv dist/esm/index.js dist/index.mjs && rm -rf dist/esm dist/__tests__",
    "prepublishOnly": "npm run build && npm test",
    "test": "jest"
  },
  "dependencies": {
    "chinese-days": "^1.5.7"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  }
}
